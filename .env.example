# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# --- Snowflake (Step 10; only needed for the Snowflake target) ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=OLIST
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS

# --- Target selection (duckdb | snowflake) — can also be set in config/config.yaml ---
WAREHOUSE_TARGET=duckdb
